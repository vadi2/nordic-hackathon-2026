            "text": {
              "status": "generated",
              "div": "<div xmlns=\"http://www.w3.org/1999/xhtml\" lang=\"en\" xml:lang=\"en\"><p>Penicillin anaphylaxis. Apixaban 2.5 mg twice daily: bleeding risk. Heart failure (NYHA II) and emphysema. Hip precautions for 6 weeks: no flexion over 90 degrees, no internal rotation, no crossing the legs</p></div>"
            }
          },
          {
            "title": "Diagnostic summary",
            "code": {
              "coding": [
                {
                  "system": "http://loinc.org",
